# Backend API Base URL Configuration
# Để trống để tự động lấy theo IP/Domain của trình duyệt (Dynamic Browser Location)
# VITE_API_BASE_URL=http://14.252.196.12:8000

# Port Backend (Mặc định: 8000 khi truy cập dev trực tiếp)
VITE_BACKEND_PORT=8000

# Cấu hình ứng dụng
VITE_PAGE_SIZE=8
VITE_MAX_FILE_SIZE=104857600  # 100MB = 100 * 1024 * 1024
VITE_MAX_FILE_SIZE=5242880  # 5MB = 5 * 1024 * 1024